# LLM provider: ollama | claude
LLM_PROVIDER=ollama

# Agent mode: tools | sql | hybrid
#   tools  = predefined tools only (33 ตัว, ปลอดภัย, แม่น)
#   sql    = text-to-SQL (LLM เขียน SQL เอง — ยืดหยุ่นแต่ช้ากว่า)
#   hybrid = predefined tools + execute_sql escape hatch (best of both)
AGENT_MODE=hybrid

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# qwen2.5:3b  qwen2.5:7b  qwen2.5:14b
# llama3.2:3b
# How long to keep the model loaded in VRAM/RAM after last use.
#   "-1"  = forever (เร็วทุก request, กิน RAM 5GB ตลอด)
#   "5m"  = default (cold start หลัง 5 นาที idle)
#   "30m" = sweet spot
OLLAMA_KEEP_ALIVE=30m

# Claude
ANTHROPIC_API_KEY=xxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Answer style
# Max sentences allowed in the AI's reply. Range 1-20 (clamped, default 3).
# Enforced both by system prompt AND post-processing (hard truncate).
#
# ค่าตัวอย่าง — ผลลัพธ์เทียบกัน (คำถาม: "สินค้าใกล้หมดมีอะไร"):
#   1 → "AirPods Pro 2 เหลือ 1 ชิ้นครับ"
#       (สั้นมาก ตอบเฉพาะ key info — เหมาะกับ quick lookup)
#   2 → "AirPods Pro 2 เหลือ 1 ชิ้น iPad Air เหลือ 2 ชิ้นครับ"
#       (สั้น แต่ครบ list สินค้า)
#   3 → เพิ่มประโยคที่ 3: "MacBook Air M3 เหลือ 3 ครับ" (✅ default)
#   4-5 → เริ่มมี context เช่น "ควรเติมสต็อกเร็ว" หรือ "เทียบกับเดือนก่อน"
#   6-10 → ตอบเป็น summary ยาว มี analysis (เหมือน mini-report)
#   11-20 → กึ่ง essay (LLM ตอบจริง ๆ ไม่ค่อยถึง — เพดานกัน typo)
#
# จุดเปลี่ยนสำคัญ:
#   1 vs 3  — ต่างมาก (มี/ไม่มี list)
#   3 vs 5  — ต่างปานกลาง (มี/ไม่มี context)
#   5 vs 10 — ต่างน้อย (LLM มักตอบไม่ถึง 10 ประโยคอยู่แล้ว)
ANSWER_MAX_SENTENCES=3

# Database (used by sql_tool)
DATABASE_URL=postgres://postgres:root@localhost:5432/cms_stock
